@{
    ViewData["Title"] = "Quên mật khẩu";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h4 class="mb-0">
                        <i class="fas fa-key me-2"></i>Khôi phục mật khẩu
                    </h4>
                </div>
                <div class="card-body p-4">

                    <p class="text-muted text-center mb-4">
                        Nhập địa chỉ Email bạn đã đăng ký. Hệ thống sẽ gửi một mật khẩu tạm thời vào hòm thư của bạn.
                    </p>

                    @* Hiển thị thông báo lỗi (Unit 4) *@
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Error
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Địa chỉ Email</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" name="sEmail" class="form-control" placeholder="ví dụ: abc@gmail.com" required />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-paper-plane me-2"></i> Gửi mật khẩu mới
                            </button>
                            <a asp-action="Login" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại đăng nhập
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>