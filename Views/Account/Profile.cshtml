@using SourceCode.Models
@using System.Security.Claims
@model SourceCode.Models.User

@{
    ViewData["Title"] = "Thông tin cá nhân";
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-user-circle me-2"></i>Thông tin cá nhân
                    </h4>
                </div>
                <div class="card-body p-4">

                    @* Hiển thị thông báo *@
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-times-circle me-2"></i>@TempData["Error"]
                        </div>
                    }

                    @* Form — gửi dữ liệu lên POST Profile *@
                    <form asp-action="Profile" asp-controller="Account" method="post">
        
                        @* 1. THÔNG TIN CƠ BẢN *@
                        <div class="row mb-3 border-bottom pb-2">
                            <label class="col-sm-3 col-form-label fw-bold">Họ và tên:</label>
                            <div class="col-sm-9">
                                <input type="text" name="sHoTen" value="@Model.sHoten" class="form-control" required />
                            </div>
                        </div>

                        <div class="row mb-3 border-bottom pb-2">
                            <label class="col-sm-3 col-form-label fw-bold">Email:</label>
                            <div class="col-sm-9 d-flex align-items-center">
                                <span class="text-dark">@Model.sEmail</span>
                            </div>
                        </div>

                        <div class="row mb-3 border-bottom pb-2">
                            <label class="col-sm-3 col-form-label fw-bold">Số điện thoại:</label>
                            <div class="col-sm-9">
                                <input type="text" name="sSDT" value="@Model.sSDT" class="form-control" placeholder="10 chữ số" maxlength="10" />
                            </div>
                        </div>

                        @* 2. THÔNG TIN RIÊNG CỦA DOANH NGHIỆP *@
                        @if (role == "doanhnghiep")
                        {
                            <div class="row mb-3 border-bottom pb-2">
                                <label class="col-sm-3 col-form-label fw-bold">Địa chỉ:</label>
                                <div class="col-sm-9">
                                    <input type="text" name="sDiaChi" value="@ViewBag.DiaChi" class="form-control" placeholder="Địa chỉ doanh nghiệp" />
                                </div>
                            </div>
                        }

                        <div class="row mb-3 pb-2">
                            <label class="col-sm-3 col-form-label fw-bold">Vai trò:</label>
                            <div class="col-sm-9 d-flex align-items-center">
                                <span class="badge bg-info text-dark">@Model.sVaiTro</span>
                            </div>
                        </div>

                        @* 3. PHẦN ĐỔI MẬT KHẨU CÓ DÙNG CHUNG *@
                        <div class="row mt-4 pt-3 border-top">
                            <div class="col-md-12 mb-3">
                                <h6 class="fw-bold text-primary mb-1"><i class="fas fa-shield-alt me-2"></i>Bảo mật tài khoản</h6>
                                <small class="text-muted"><i>(Để trống 2 ô dưới đây nếu bạn không muốn đổi mật khẩu)</i></small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Mật khẩu cũ:</label>
                                <input type="password" name="oldPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Mật khẩu mới:</label>
                                <input type="password" name="newPassword" class="form-control" placeholder="Mật khẩu mới (ít nhất 6 ký tự)">
                            </div>
                        </div>

                        @* 4. NÚT THAO TÁC *@
                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            @if (role == "admin")
                            {
                                <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                                </a>
                            }
                            else if (role == "doanhnghiep")
                            {
                                <a asp-controller="Home" asp-action="Enterprise" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="SinhVien" class="btn btn-outline-secondary">
                                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                                </a>
                            }

                            @if (role != "admin")
                            {
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fas fa-save me-1"></i> Lưu thay đổi
                                </button>
                            }
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>