@using SourceCode.Models
@using System.Security.Claims
@model SourceCode.Models.User

@{
    ViewData["Title"] = "Thông tin cá nhân";
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-user-circle me-2"></i>Thông tin cá nhân</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3 border-bottom pb-2">
                        <label class="col-sm-3 col-form-label fw-bold">Họ và tên:</label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="text-dark">@Model.sHoten</span>
                        </div>
                    </div>
                    <div class="row mb-3 border-bottom pb-2">
                        <label class="col-sm-3 col-form-label fw-bold">Email:</label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="text-dark">@Model.sEmail</span>
                        </div>
                    </div>
                    <div class="row mb-3 border-bottom pb-2">
                        <label class="col-sm-3 col-form-label fw-bold">Số điện thoại:</label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="text-dark">@(string.IsNullOrEmpty(Model.sSDT) ? "Chưa cập nhật" : Model.sSDT)</span>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label fw-bold">Vai trò:</label>
                        <div class="col-sm-9 d-flex align-items-center">
                            <span class="badge bg-info text-dark">@Model.sVaiTro</span>
                        </div>
                    </div>

                    <div class="mt-4 d-flex justify-content-end">
                        @if (role == "admin")
                        {
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        }
                        else if (role == "doanhnghiep")
                        {
                            <a asp-controller="Home" asp-action="Enterprise" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Job" asp-action="SinhVien" class="btn btn-outline-secondary me-2">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                        }

                        <button class="btn btn-primary px-4">
                            <i class="fas fa-edit me-1"></i> Chỉnh sửa thông tin
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
