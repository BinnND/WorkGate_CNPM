@{
    ViewData["Title"] = "Đăng Nhập";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    body {
        background-color: #f8f9fa;
    }

    .workgate-container {
        max-width: 450px;
        margin: 50px auto;
    }

    .brand-title {
        color: #2c5282;
        font-weight: 700;
        font-size: 32px;
        text-align: center;
        margin-bottom: 20px;
    }

    .custom-card {
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        background-color: #fff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    /* Style cho phần Tab Đăng Nhập / Đăng Ký */
    .auth-tabs {
        display: flex;
        border-bottom: 1px solid #e2e8f0;
    }

    .auth-tab {
        flex: 1;
        text-align: center;
        padding: 12px 0;
        font-weight: 600;
        text-decoration: none;
        color: #4a5568;
        background-color: #f7fafc;
    }

        .auth-tab.active {
            background-color: #3182ce;
            color: white;
        }

        .auth-tab:not(.active) {
            border-left: 1px solid #e2e8f0;
        }
    
    /* Chỉnh sửa ô input có icon */
    .input-group-text {
        background-color: white;
        border-right: none;
        color: #a0aec0;
    }

    .form-control.with-icon-left {
        border-left: none;
    }

        .form-control.with-icon-left:focus,
        .form-control.with-icon-right:focus {
            box-shadow: none;
            border-color: #ced4da;
        }

    .input-group:focus-within {
        box-shadow: 0 0 0 0.25rem rgba(49, 130, 206, 0.25);
        border-radius: 0.375rem;
    }

        .input-group:focus-within .input-group-text,
        .input-group:focus-within .form-control {
            border-color: #86b7fe;
        }
    
    /* Nút bấm */
    .btn-primary-custom {
        background-color: #3182ce;
        border-color: #3182ce;
        color: white;
        font-weight: 600;
    }

        .btn-primary-custom:hover {
            background-color: #2b6cb0;
        }

    .btn-outline-custom {
        color: #3182ce;
        border: 1px solid #e2e8f0;
        font-weight: 600;
    }

        .btn-outline-custom:hover {
            background-color: #f7fafc;
        }
    
    /* Dấu sao đổi mật khẩu (eye toggle) */
    .cursor-pointer {
        cursor: pointer;
    }
</style>

<div class="workgate-container">
    <div class="brand-title">WorkGate</div>

    <div class="custom-card">
        <div class="auth-tabs">
            <div class="auth-tab active">Đăng Nhập</div>
            <a href="@Url.Action("Register", "Account")" class="auth-tab">Đăng Ký</a>
        </div>

        <div class="card-body p-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success p-2 mb-3 text-center">@TempData["Success"]</div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger p-2 mb-3 text-center">@ViewBag.Error</div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" name="email" class="form-control with-icon-left" placeholder="Email" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" id="passwordInput" class="form-control with-icon-left border-end-0" placeholder="••••••••" required />
                        <span class="input-group-text bg-white border-left-0 cursor-pointer" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 mb-2 py-2">Đăng Nhập</button>
                <a href="@Url.Action("Register", "Account")" class="btn btn-outline-custom w-100 py-2 d-block text-center text-decoration-none">Đăng Ký</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#passwordInput');
        const eyeIcon = togglePassword.querySelector('i');

        togglePassword.addEventListener('click', function (e) {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            eyeIcon.classList.toggle('fa-eye');
            eyeIcon.classList.toggle('fa-eye-slash');
        });
    </script>
}