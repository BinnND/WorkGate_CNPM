@model SourceCode.Models.Job
@{
    ViewData["Title"] = "Đăng tin mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Tạo Tin Tuyển Dụng Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tiêu đề công việc</label>
                            <input asp-for="Title" class="form-control" placeholder="VD: Senior .NET Developer" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Địa điểm</label>
                                <input asp-for="Location" class="form-control" placeholder="Hà Nội, TP.HCM..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Lương (VNĐ)</label>
                                <input asp-for="Salary" type="number" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả công việc</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Yêu cầu ứng viên</label>
                            <textarea asp-for="Requirements" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Home" asp-action="Enterprise" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4">Đăng tin ngay</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>