<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkGate</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, sans-serif; margin: 0; }
        .navbar-custom { background-color: white; border-bottom: 1px solid #e2e8f0; height: 65px; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 1000; }
        .nav-left { display: flex; align-items: center; height: 100%; }
        .brand { color: #2c5282; font-weight: 700; font-size: 24px; text-decoration: none; margin-right: 40px; }
        .nav-links { display: flex; list-style: none; margin: 0; padding: 0; height: 65px; }
        .nav-links li { margin-right: 30px; height: 100%; }
        .nav-links a { color: #4a5568; text-decoration: none; font-weight: 600; display: flex; align-items: center; height: 100%; padding: 0 5px; border-bottom: 3px solid transparent; transition: all 0.2s; }
        .nav-links a.active { color: #3182ce; border-bottom-color: #3182ce; }
        .avatar { width: 35px; height: 35px; background-color: #edf2f7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #2c5282; margin-right: 10px; border: 1px solid #cbd5e0; }
    </style>
</head>
<body>
    <header class="navbar-custom">
        <div class="nav-left">
            <i class="fas fa-bars text-secondary me-3" style="cursor:pointer"></i>
            <a asp-controller="Home" asp-action="SinhVien" class="brand">WorkGate</a>
            
            <ul class="nav-links">
                <li>
                    <a asp-controller="Home" asp-action="SinhVien" 
                       class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "SinhVien" ? "active" : "")">
                       Tìm Việc
                    </a>
                </li>
                <li>
                    <a asp-controller="CV" asp-action="Index" 
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "CV" ? "active" : "")">
                       Hồ Sơ
                    </a>
                </li>
            </ul>
        </div>

        <div class="dropdown">
            <div class="d-flex align-items-center" id="userMenu" data-bs-toggle="dropdown" style="cursor:pointer">
                <div class="avatar">@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</div>
                <span class="fw-bold text-dark">@User.Identity.Name</span>
                <i class="fas fa-chevron-down ms-2 text-muted" style="font-size: 12px;"></i>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="fas fa-user-circle me-2"></i>Thông tin cá nhân</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
            </ul>
        </div>
    </header>

    <div class="container-fluid pt-4">
        @RenderBody() </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>