@model IEnumerable<SourceCode.Models.Application>

@{
    ViewData["Title"] = "Danh Sách Ứng Viên - Doanh Nghiệp";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkGate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { background-color: #fff; font-family: 'Segoe UI', sans-serif; color: #2d3748; }
        .navbar-custom { background-color: #f8f9fa; border-bottom: 1px solid #e2e8f0; padding: 0 1.5rem; height: 60px; }
        .navbar-brand-text { color: #2c5282; font-weight: 700; font-size: 22px; }
        .sidebar { background-color: #f8f9fa; border-right: 1px solid #e2e8f0; min-height: calc(100vh - 60px); padding: 0; }
        .sidebar-menu { list-style: none; padding: 0; margin: 0; }
        .sidebar-cta { display: block; padding: 15px 20px; background-color: #3182ce; color: white; font-weight: 600; text-decoration: none; }
        .sidebar-link { display: block; padding: 12px 20px; color: #4a5568; text-decoration: none; font-weight: 500; }
        .sidebar-link:hover { background-color: #edf2f7; color: #2d3748; }
        .sidebar-link.active { border-left: 4px solid #3182ce; background-color: #ebf8ff; color: #3182ce; }
        .content-area { padding: 20px 30px; }
        .page-title { font-size: 20px; font-weight: 600; padding-bottom: 15px; border-bottom: 1px solid #e2e8f0; margin-bottom: 20px; }
        .table-custom th { background-color: #f7fafc; color: #4a5568; border-bottom: 2px solid #e2e8f0; padding: 12px; }
        .btn-action { font-weight: 600; font-size: 14px; padding: 6px 12px; border: none; border-radius: 4px; }
        .btn-view { background-color: #3182ce; color: white; text-decoration: none; }
        .btn-approve { background-color: #48bb78; color: white; }
        .btn-reject { background-color: #e53e3e; color: white; }
        .status-badge { font-size: 12px; padding: 4px 8px; border-radius: 12px; font-weight: 600; }
    </style>
</head>
<body>

    <header class="navbar-custom d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <i class="fas fa-bars text-secondary me-3" style="font-size: 20px; cursor:pointer;"></i>
            <div class="navbar-brand-text">WorkGate</div>
        </div>
        <div class="user-profile d-flex align-items-center" style="cursor: pointer;">
            <div class="avatar-circle me-2">@(User.Identity.Name?.Substring(0,1).ToUpper())</div>
            <span class="fw-semibold text-dark">@User.Identity.Name</span>
            <i class="fas fa-chevron-down ms-2 text-secondary" style="font-size: 12px;"></i>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3 col-lg-2 sidebar">
    <ul class="sidebar-menu">
        <li>
            @* Trỏ về JobController, Action Create *@
            <a asp-controller="Job" asp-action="Create" class="sidebar-cta">
                <i class="fas fa-plus me-2"></i> Đăng Tin Tuyển Dụng
            </a>
        </li>
        <li>
            @* Trỏ về JobController, Action Index (hoặc danh sách bài đăng của doanh nghiệp) *@
            <a asp-controller="Job" asp-action="Index" class="sidebar-link">
                Quản Lý Tuyển Dụng
            </a>
        </li>
        <li>
            @* Đây là trang hiện tại bạn đang đứng *@
            <a asp-controller="Home" asp-action="Enterprise" class="sidebar-link active">
                Danh Sách Ứng Viên
            </a>
        </li>
        <li>
            @* Thống kê - Bạn có thể tạo thêm Action Statistics sau *@
            <a asp-controller="Home" asp-action="Statistics" class="sidebar-link">
                Báo Cáo Thống Kê
            </a>
        </li>
        <li>
            @* Cài đặt hệ thống *@
            <a href="#" class="sidebar-link">Cài Đặt Hệ Thống</a>
        </li>
    </ul>
</div>

            <div class="col-md-9 col-lg-10 content-area">
                <div class="page-title">Danh sách ứng viên</div>

                <form method="get" class="input-group mb-4">
                    <input type="text" name="search" class="form-control shadow-none" placeholder="Tìm kiếm ứng viên...">
                    <button class="btn btn-outline-secondary border-start-0" type="submit"><i class="fas fa-search text-primary"></i></button>
                </form>

                <div class="table-responsive">
                    <table class="table table-custom">
                        <thead>
                            <tr>
                                <th>Họ và tên</th>
                                <th>Vị trí ứng tuyển</th>
                                <th>Trạng thái</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var app in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">@app.Student?.FullName</td>
                                        <td>@app.Job?.Title</td>
                                        <td>
                                            @if (app.Status == "Approved") { <span class="status-badge bg-success text-white">Đã Duyệt</span> }
                                            else if (app.Status == "Rejected") { <span class="status-badge bg-danger text-white">Từ Chối</span> }
                                            else { <span class="status-badge bg-warning text-dark">Chờ Duyệt</span> }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a href="/CV/Details/@app.UserId" class="btn btn-action btn-view">Xem CV</a>
                                                
                                                @if (app.Status == "Pending")
                                                {
                                                    <form asp-action="Approve" asp-route-id="@app.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-action btn-approve">Duyệt</button>
                                                    </form>
                                                    <form asp-action="Reject" asp-route-id="@app.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-action btn-reject">Từ Chối</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có ứng viên nào ứng tuyển.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>