@model IEnumerable<SourceCode.Models.UngTuyen>
@using System.Security.Claims
@{
    ViewData["Title"] = "Danh sách ứng viên";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkGate</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; }
        body { background: #f3f4f6; font-family: 'Segoe UI', sans-serif; margin: 0; }
        .topbar { background: #fff; border-bottom: 1px solid #e5e7eb; height: 56px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; position: sticky; top: 0; z-index: 100; }
        .brand { font-weight: 700; font-size: 20px; color: #1e3a5f; text-decoration: none; }
        .avatar { width: 32px; height: 32px; background: #dbeafe; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; color: #1d4ed8; }
        .layout { display: flex; min-height: calc(100vh - 56px); }
        .sidebar { width: 220px; background: #fff; border-right: 1px solid #e5e7eb; flex-shrink: 0; }
        .sidebar-cta { display: flex; align-items: center; gap: 8px; padding: 14px 18px; background: #2563eb; color: #fff; font-weight: 600; font-size: 14px; text-decoration: none; }
        .sidebar-cta:hover { background: #1d4ed8; color: #fff; }
        .sidebar-link { display: flex; align-items: center; gap: 10px; padding: 12px 18px; color: #4b5563; font-size: 14px; text-decoration: none; border-left: 3px solid transparent; }
        .sidebar-link:hover { background: #f9fafb; color: #111827; }
        .sidebar-link.active { border-left-color: #2563eb; background: #eff6ff; color: #2563eb; font-weight: 500; }
        .content { flex: 1; padding: 24px 28px; }
        .page-title { font-size: 18px; font-weight: 600; color: #111827; margin-bottom: 20px; }
        .wg-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden; }
        .wg-card-header { padding: 14px 18px; border-bottom: 1px solid #f3f4f6; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
        table { width: 100%; font-size: 13px; border-collapse: collapse; }
        thead th { background: #f9fafb; padding: 10px 16px; font-size: 12px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.03em; border-bottom: 1px solid #e5e7eb; }
        tbody td { padding: 13px 16px; border-bottom: 1px solid #f3f4f6; color: #111827; vertical-align: middle; }
        tbody tr:last-child td { border-bottom: none; }
        tbody tr:hover { background: #fafafa; }
        .badge-green  { background: #f0fdf4; color: #15803d; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 500; display:inline-block; }
        .badge-red    { background: #fef2f2; color: #b91c1c; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 500; display:inline-block; }
        .badge-yellow { background: #fffbeb; color: #92400e; font-size: 11px; padding: 3px 10px; border-radius: 20px; font-weight: 500; display:inline-block; }
        .btn-sm-blue  { font-size: 12px; padding: 5px 12px; border-radius: 7px; background: #eff6ff; color: #1d4ed8; border: none; cursor: pointer; text-decoration: none; display:inline-flex; align-items:center; gap:4px; }
        .btn-sm-green { font-size: 12px; padding: 5px 12px; border-radius: 7px; background: #f0fdf4; color: #15803d; border: none; cursor: pointer; display:inline-flex; align-items:center; gap:4px; }
        .btn-sm-red   { font-size: 12px; padding: 5px 12px; border-radius: 7px; background: #fef2f2; color: #b91c1c; border: none; cursor: pointer; display:inline-flex; align-items:center; gap:4px; }
        .tab-btn { font-size: 13px; padding: 5px 14px; border-radius: 8px; border: 1px solid #e5e7eb; background: #fff; color: #6b7280; cursor: pointer; transition: all 0.15s; }
        .tab-btn.active { background: #2563eb; color: #fff; border-color: #2563eb; }
        .search-input { height: 34px; border: 1px solid #e5e7eb; border-radius: 8px; padding: 0 12px; font-size: 13px; outline: none; width: 220px; }
        .search-input:focus { border-color: #93c5fd; }
        .avatar-sm { width: 32px; height: 32px; border-radius: 50%; background: #eff6ff; color: #2563eb; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
        .empty-row td { text-align: center; padding: 48px; color: #9ca3af; }
        .stat-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-bottom: 20px; }
        .stat-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px 18px; }
        .stat-label { font-size: 12px; color: #6b7280; margin-bottom: 4px; }
        .stat-num { font-size: 24px; font-weight: 600; color: #111827; }
    </style>
</head>
<body>

<div class="topbar">
    <a asp-controller="Home" asp-action="Enterprise" class="brand">WorkGate</a>
    <div class="dropdown">
        <div class="d-flex align-items-center gap-2" data-bs-toggle="dropdown" style="cursor:pointer">
            <div class="avatar">@(User.Identity.Name?.Substring(0,1).ToUpper())</div>
            <div>
                <div style="font-size:13px;font-weight:600;color:#111827;">@User.Identity.Name</div>
                <div style="font-size:11px;color:#6b7280;">Doanh nghiệp</div>
            </div>
            <i class="fas fa-chevron-down ms-1 text-muted" style="font-size:10px;"></i>
        </div>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-2">
            <li><a class="dropdown-item py-2 rounded" asp-controller="Job" asp-action="Profile"><i class="fas fa-user-circle me-2 text-primary"></i>Thông tin cá nhân</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item py-2 rounded text-danger" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
        </ul>
    </div>
</div>

<div class="layout">
    <div class="sidebar">
        <a asp-controller="Job" asp-action="Create" class="sidebar-cta">
            <i class="fas fa-plus"></i> Đăng tin tuyển dụng
        </a>
        <a asp-controller="Job" asp-action="Index" class="sidebar-link">
            <i class="fas fa-tasks"></i> Quản lý tuyển dụng
        </a>
        <a asp-controller="Home" asp-action="Applicants" class="sidebar-link active">
            <i class="fas fa-users"></i> Danh sách ứng viên
        </a>
    </div>

    <div class="content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="page-title">Danh sách ứng viên</div>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-label">Tổng đơn ứng tuyển</div>
                <div class="stat-num">@Model.Count()</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Chờ xem xét</div>
                <div class="stat-num" style="color:#92400e;">@Model.Count(u => u.sTrangThaiUngTuyen == "Pending")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Đã duyệt</div>
                <div class="stat-num" style="color:#15803d;">@Model.Count(u => u.sTrangThaiUngTuyen == "Approved")</div>
            </div>
        </div>

        <div class="wg-card">
            <div class="wg-card-header">
                <div class="d-flex gap-2 flex-wrap">
                    <button class="tab-btn active" onclick="filterApps('all', this)">Tất cả (@Model.Count())</button>
                    <button class="tab-btn" onclick="filterApps('Pending', this)">Chờ duyệt (@Model.Count(u => u.sTrangThaiUngTuyen == "Pending"))</button>
                    <button class="tab-btn" onclick="filterApps('Approved', this)">Đã duyệt (@Model.Count(u => u.sTrangThaiUngTuyen == "Approved"))</button>
                    <button class="tab-btn" onclick="filterApps('Rejected', this)">Từ chối (@Model.Count(u => u.sTrangThaiUngTuyen == "Rejected"))</button>
                </div>
                <input type="text" class="search-input" placeholder="Tìm ứng viên, vị trí..." oninput="searchApps(this.value)" />
            </div>

            <table id="appTable">
                <thead>
                    <tr>
                        <th>Ứng viên</th>
                        <th>Vị trí ứng tuyển</th>
                        <th>Trình độ</th>
                        <th>Kỹ năng</th>
                        <th>Ngày ứng tuyển</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="7">
                                <i class="fas fa-users fa-2x d-block mb-2"></i>
                                Chưa có ứng viên nào ứng tuyển
                            </td>
                        </tr>
                    }
                    @foreach (var app in Model)
                    {
                        var stClass = app.sTrangThaiUngTuyen switch {
                            "Approved" => "badge-green",
                            "Rejected" => "badge-red",
                            _          => "badge-yellow"
                        };
                        var stLabel = app.sTrangThaiUngTuyen switch {
                            "Approved" => "Đã duyệt",
                            "Rejected" => "Từ chối",
                            _          => "Chờ duyệt"
                        };
                        var hoSo = app.HoSoSinhVien;
                        var ten = hoSo?.FK_sMaSV ?? app.FK_sMaHoSo;
                        <tr data-status="@app.sTrangThaiUngTuyen">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm">@ten.Substring(0, 1).ToUpper()</div>
                                    <div>
                                        <div class="fw-semibold">@ten</div>
                                        <div style="font-size:11px;color:#9ca3af;">@app.PK_sMaUngTuyen</div>
                                    </div>
                                </div>
                            </td>
                            <td>@(app.TinTuyenDung?.sViTriCV ?? app.FK_sMaTin)</td>
                            <td class="text-muted">@(hoSo?.sTrinhDoHocVan ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(hoSo?.sKyNang))
                                {
                                    <span style="font-size:12px;color:#4b5563;max-width:150px;display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">@hoSo.sKyNang</span>
                                }
                                else { <span class="text-muted">—</span> }
                            </td>
                            <td class="text-muted">@app.dNgayUngTuyen.ToString("dd/MM/yyyy")</td>
                            <td><span class="@stClass">@stLabel</span></td>
                            <td>
                                <div class="d-flex gap-2 justify-content-end">
                                    @if (!string.IsNullOrEmpty(hoSo?.sFileCV))
                                    {
                                        <a href="@hoSo.sFileCV" target="_blank" class="btn-sm-blue">
                                            <i class="fas fa-file-pdf"></i> Xem CV
                                        </a>
                                    }
                                    @if (app.sTrangThaiUngTuyen == "Pending")
                                    {
                                        <form asp-controller="Home" asp-action="ApproveApplicant" asp-route-id="@app.PK_sMaUngTuyen" method="post" class="d-inline">
                                            <button type="submit" class="btn-sm-green" onclick="return confirm('Duyệt ứng viên này?')">
                                                <i class="fas fa-check"></i> Duyệt
                                            </button>
                                        </form>
                                        <form asp-controller="Home" asp-action="RejectApplicant" asp-route-id="@app.PK_sMaUngTuyen" method="post" class="d-inline">
                                            <button type="submit" class="btn-sm-red" onclick="return confirm('Từ chối ứng viên này?')">
                                                <i class="fas fa-times"></i> Từ chối
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function filterApps(status, btn) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#appTable tbody tr').forEach(row => {
            row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
        });
    }

    function searchApps(q) {
        q = q.toLowerCase();
        document.querySelectorAll('#appTable tbody tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }
</script>
</body>
</html>
