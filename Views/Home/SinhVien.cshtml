@using SourceCode.Models
@model IEnumerable<SourceCode.Models.TinTuyenDung>

@{
    ViewData["Title"] = "Trang Chủ - Tìm Việc Làm";
    Layout = null; 
}<!DOCTYPE html><html lang="vi"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkGate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { background-color: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .navbar-custom { background-color: white; border-bottom: 1px solid #e2e8f0; padding: 0 1.5rem; height: 60px; }
        .navbar-brand-text { color: #2c5282; font-weight: 700; font-size: 22px; margin-right: 30px; }
        .nav-tabs-custom { display: flex; list-style: none; padding: 0; margin: 0; height: 100%; }
        .nav-tabs-custom li { margin-right: 20px; }
        .nav-tabs-custom a { color: #4a5568; text-decoration: none; font-weight: 600; display: flex; align-items: center; height: 100%; padding: 0 5px; border-bottom: 3px solid transparent; }
        .nav-tabs-custom a.active { color: #3182ce; border-bottom-color: #3182ce; }
        .avatar-circle { width: 32px; height: 32px; background-color: #cbd5e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; color: #2c5282; }
        
        /* Cấu trúc Card công việc */
        .job-card { 
            background: white; 
            border: 1px solid #e2e8f0; 
            border-radius: 12px; 
            padding: 25px; 
            margin-bottom: 20px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            transition: all 0.3s ease; 
            position: relative; /* Bắt buộc để làm overlay link */
        }
        .job-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important; background-color: #fcfcfc; }
        
        .job-title { font-size: 20px; font-weight: 700; color: #2d3748; margin-bottom: 8px; }
        .job-info { font-size: 15px; color: #4a5568; margin-bottom: 5px; }
        
        /*.company-link::after { 
            position: absolute; 
            top: 0; 
            right: 180px; 
            bottom: 0; 
            left: 0; 
            z-index: 1; 
            content: ""; 
        }*/
        
        .btn-apply { 
            background-color: #3182ce; 
            color: white; 
            font-weight: 600; 
            border: none; 
            padding: 10px 30px; 
            border-radius: 6px; 
            transition: 0.2s; 
            position: relative; 
            z-index: 2; 
        }
        .btn-apply:hover { background-color: #2b6cb0; }
        .alert { border-radius: 8px; border: none; }
    </style></head><body>

    <header class="navbar-custom d-flex align-items-center justify-content-between mb-4 shadow-sm">
        <div class="d-flex align-items-center h-100">
            <i class="fas fa-bars text-secondary me-3" style="font-size: 20px; cursor:pointer;"></i>
            <div class="navbar-brand-text">WorkGate</div>
            
            <ul class="nav-tabs-custom">
                <li><a asp-controller="Job" asp-action="SinhVien" class="active">Tìm Việc</a></li>
                <li><a asp-controller="CV" asp-action="Index">Hồ Sơ</a></li>
            </ul>
        </div>

        <div class="dropdown">
            <div class="d-flex align-items-center" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                <div class="avatar-circle me-2 text-uppercase">
                    @(User.Identity.Name?.Substring(0, 1) ?? "U")
                </div>
                <span class="fw-semibold text-dark">@User.Identity.Name</span>
                <i class="fas fa-chevron-down ms-2 text-secondary" style="font-size: 12px;"></i>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userDropdown">
                <li class="px-3 py-2 border-bottom">
                    <div class="small text-muted">Tài khoản sinh viên</div>
                    <div class="fw-bold text-primary">@User.Identity.Name</div>
                </li>
              
                <li>
                    <a class="dropdown-item py-2" asp-controller="Job" asp-action="Profile">
                        <i class="fas fa-user-circle me-2"></i>Thông tin cá nhân
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item py-2 text-danger" asp-controller="Account" asp-action="Logout">
                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                    </a>
                </li>
            </ul>
        </div>
    </header>

    <div class="container py-2">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form method="get" asp-controller="Job" asp-action="SinhVien" class="mb-5">
                    <div class="input-group shadow-sm" style="border-radius: 10px; overflow: hidden;">
                        <span class="input-group-text bg-white border-0 ps-4"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control border-0 py-3 shadow-none" placeholder="Tìm kiếm vị trí công việc, công ty, địa điểm...">
                        <button class="btn btn-primary px-4 fw-bold" type="submit">Tìm kiếm</button>
                    </div>
                </form>

                <h4 class="mb-4 fw-bold text-dark">Việc làm gợi ý cho bạn</h4>

                @if (Model != null && Model.Any())
                {
                    @foreach (var job in Model)
                    {
                        <div class="job-card shadow-sm border-0">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-3 me-4 d-none d-md-block">
                                    <i class="fas fa-briefcase fa-2x text-primary"></i>
                                </div>
                                <div style="position: relative; z-index: 5;"> <h5 class="job-title mb-1">@job.sViTriCV</h5>

                                        <div class="mb-2" style="position: relative; z-index: 10;">
                                            <i class="fas fa-building me-2 text-muted"></i>
                                            <a asp-controller="Home" 
                                                asp-action="EnterpriseDetails" 
                                                asp-route-id="@job.FK_sMaDN" 
                                                class="text-primary fw-bold text-decoration-none">
                                                Xem chi tiết doanh nghiệp
                                            </a>
                                        </div>

                                    <div class="job-info text-secondary">
                                        <i class="fas fa-map-marker-alt me-2 text-muted"></i>@job.sDiaDiem
                                    </div>
                                    <div class="text-muted small mt-2 fw-medium">
                                        <i class="far fa-calendar-alt me-1"></i> Hạn nộp: 
                                        <span class="text-danger">@job.dHanNop.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
        
                            <div class="text-end" style="position: relative; z-index: 10;">
                                <form asp-controller="Job" asp-action="Apply" method="post">
                                    <input type="hidden" name="idTin" value="@job.PK_sMaTin" />
                                    <button type="submit" class="btn btn-apply shadow-sm">Ứng Tuyển</button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 bg-white rounded shadow-sm">
                        <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" style="width: 120px; opacity: 0.3" />
                        <h5 class="text-muted mt-4">Rất tiếc, chúng tôi không tìm thấy công việc phù hợp!</h5>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script></body></html>