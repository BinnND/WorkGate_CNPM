@using SourceCode.Models
@model IEnumerable<SourceCode.Models.TinTuyenDung>

@{
    ViewData["Title"] = "Trang Chủ - Tìm Việc Làm";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkGate</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body {
            background: #f4f6fb;
            font-family: 'Be Vietnam Pro', sans-serif;
            color: #1a202c;
        }

        /* ── Navbar ── */
        .wg-navbar {
            background: #fff;
            border-bottom: 1px solid #e8ecf3;
            height: 60px;
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .wg-brand {
            font-size: 20px;
            font-weight: 700;
            color: #1a56db;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
        .wg-brand i { font-size: 18px; }
        .wg-nav-links { display: flex; gap: 4px; }
        .wg-nav-links a {
            font-size: 14px;
            font-weight: 500;
            color: #4a5568;
            text-decoration: none;
            padding: 6px 14px;
            border-radius: 8px;
            transition: all 0.15s;
        }
        .wg-nav-links a:hover { background: #f0f4ff; color: #1a56db; }
        .wg-nav-links a.active { background: #eff4ff; color: #1a56db; font-weight: 600; }

        /* Avatar dropdown */
        .avatar-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 10px;
            transition: background 0.15s;
            border: none;
            background: transparent;
        }
        .avatar-btn:hover { background: #f0f4ff; }
        .avatar-circle {
            width: 34px; height: 34px;
            background: #1a56db;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700; color: #fff;
            text-transform: uppercase;
        }
        .avatar-name { font-size: 14px; font-weight: 600; color: #1a202c; }

        /* ── Hero search ── */
        .wg-hero {
            background: #fff;
            border-bottom: 1px solid #e8ecf3;
            padding: 28px 32px;
        }
        .wg-hero h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a202c;
            margin-bottom: 16px;
        }
        .search-bar {
            display: flex;
            gap: 10px;
            max-width: 720px;
        }
        .search-input-wrap {
            flex: 1;
            position: relative;
        }
        .search-input-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #a0aec0;
            font-size: 14px;
        }
        .search-input-wrap input {
            width: 100%;
            height: 44px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            padding: 0 14px 0 38px;
            font-size: 14px;
            font-family: inherit;
            outline: none;
            transition: border-color 0.15s;
            background: #f8faff;
        }
        .search-input-wrap input:focus { border-color: #1a56db; background: #fff; }
        .search-btn {
            height: 44px;
            padding: 0 24px;
            background: #1a56db;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background 0.15s;
            white-space: nowrap;
        }
        .search-btn:hover { background: #1648c0; }

        /* ── Main content ── */
        .wg-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 28px 32px;
        }
        .wg-result-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .wg-result-bar span {
            font-size: 14px;
            color: #4a5568;
            font-weight: 500;
        }
        .wg-result-bar strong { color: #1a202c; }

        /* ── Job Grid ── */
        .job-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }
        @@media (max-width: 992px) { .job-grid { grid-template-columns: repeat(2, 1fr); } }
        @@media (max-width: 600px)  { .job-grid { grid-template-columns: 1fr; } }
        .job-card {
            background: #fff;
            border: 1.5px solid #e8ecf3;
            border-radius: 14px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: all 0.2s;
            cursor: pointer;
        }
        .job-card:hover {
            border-color: #1a56db;
            box-shadow: 0 4px 20px rgba(26,86,219,0.10);
            transform: translateY(-2px);
        }

        .job-card-top { display: flex; align-items: flex-start; gap: 12px; }
        .job-icon {
            width: 44px; height: 44px;
            background: #eff4ff;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            font-size: 18px;
            color: #1a56db;
        }
        .job-title-wrap { flex: 1; min-width: 0; }
        .job-title {
            font-size: 14px;
            font-weight: 700;
            color: #1a202c;
            margin: 0 0 4px;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .job-company {
            font-size: 12px;
            color: #1a56db;
            font-weight: 500;
            text-decoration: none;
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .job-company:hover { text-decoration: underline; }

        .job-meta { display: flex; flex-wrap: wrap; gap: 6px; }
        .job-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: #4a5568;
            background: #f4f6fb;
            border-radius: 6px;
            padding: 4px 8px;
        }
        .job-tag i { color: #a0aec0; font-size: 11px; }
        .job-tag.salary { color: #15803d; background: #f0fdf4; }
        .job-tag.deadline { color: #b91c1c; background: #fff5f5; }
        .job-tag.deadline-ok { color: #6b7280; background: #f4f6fb; }

        .job-desc {
            font-size: 12px;
            color: #6b7280;
            line-height: 1.6;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .job-card-footer {
            display: flex;
            justify-content: flex-end;
            margin-top: auto;
            padding-top: 4px;
            border-top: 1px solid #f4f6fb;
        }
        .btn-apply {
            font-size: 13px;
            font-weight: 600;
            padding: 7px 18px;
            background: #1a56db;
            color: #fff;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.15s;
        }
        .btn-apply:hover { background: #1648c0; }

        /* ── Empty state ── */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background: #fff;
            border-radius: 16px;
            border: 1.5px dashed #e2e8f0;
        }
        .empty-state img { width: 100px; opacity: 0.25; margin-bottom: 16px; }
        .empty-state h5 { font-size: 15px; color: #6b7280; font-weight: 500; }

        /* ── Alerts ── */
        .wg-alert {
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .wg-alert-success { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
        .wg-alert-error   { background: #fff5f5; color: #b91c1c; border: 1px solid #fecaca; }

        /* dropdown */
        .dropdown-menu { font-size: 13px; border-radius: 12px; border: 1px solid #e8ecf3; }
        .dropdown-item { padding: 9px 16px; border-radius: 8px; }
        .dropdown-item:hover { background: #f0f4ff; }
    </style>
</head>
<body>

<!-- Navbar -->
<nav class="wg-navbar">
    <div class="d-flex align-items-center gap-4">
        <a class="wg-brand" href="#">
            <i class="fas fa-briefcase"></i> WorkGate
        </a>
        <div class="wg-nav-links">
            <a asp-controller="Job" asp-action="SinhVien" class="active">
                <i class="fas fa-search me-1"></i>Việc làm
            </a>
            <a asp-controller="CV" asp-action="Index">
                <i class="fas fa-file-alt me-1"></i>Hồ sơ
            </a>
        </div>
    </div>

    <div class="dropdown">
        <button class="avatar-btn" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="avatar-circle">@(User.Identity.Name?.Substring(0, 1) ?? "U")</div>
            <span class="avatar-name">@User.Identity.Name</span>
            <i class="fas fa-chevron-down text-secondary" style="font-size:11px;"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow mt-2" aria-labelledby="userDropdown">
            <li class="px-3 py-2 border-bottom">
                <div class="small text-muted">Tài khoản sinh viên</div>
                <div class="fw-bold text-primary" style="font-size:13px;">@User.Identity.Name</div>
            </li>
            <li>
                <a class="dropdown-item" asp-controller="Job" asp-action="Profile">
                    <i class="fas fa-user-circle me-2 text-muted"></i>Thông tin cá nhân
                </a>
            </li>
            <li><hr class="dropdown-divider my-1"></li>
            <li>
                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                    <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                </a>
            </li>
        </ul>
    </div>
</nav>

<!-- Hero / Search -->
<div class="wg-hero">
    <h2>Tìm kiếm việc làm</h2>
    <form method="get" asp-controller="Home" asp-action="SinhVien">
    <div class="search-bar">
        <div class="search-input-wrap">
            <i class="fas fa-search"></i>
            <input type="text" name="searchString" value="@ViewBag.SearchString"
                   placeholder="Tìm theo vị trí, công ty..." />
        </div>
        <div class="search-input-wrap" style="max-width:200px;">
            <i class="fas fa-map-marker-alt"></i>
            <input type="text" name="diaDiem" value="@ViewBag.DiaDiem"
                   placeholder="Địa điểm" />
        </div>
        <button type="submit" class="search-btn">
            <i class="fas fa-search me-2"></i>Tìm kiếm
        </button>
        <a asp-action="SinhVien" class="btn btn-light ms-2" style="border-radius:10px; line-height:30px;">Xóa lọc</a>
    </div>
</form>
</div>

<!-- Content -->
<div class="wg-content">

    @if (TempData["Success"] != null)
    {
        <div class="wg-alert wg-alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="wg-alert wg-alert-error">
            <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <div class="wg-result-bar">
        <span>Tìm thấy <strong>@(Model?.Count() ?? 0)</strong> việc làm</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="job-grid">
            @foreach (var job in Model)
            {
                <div class="job-card">
                    <div class="job-card-top">
                        <div class="job-icon">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <div class="job-title-wrap">
                            <p class="job-title">@job.sViTriCV</p>
                            <a asp-controller="Home"
                               asp-action="EnterpriseDetails"
                               asp-route-id="@job.FK_sMaDN"
                               class="job-company">
                                <i class="fas fa-building me-1"></i>@job.FK_sMaDN
                            </a>
                        </div>
                    </div>

                    <div class="job-meta">
                        <span class="job-tag">
                            <i class="fas fa-map-marker-alt"></i>@job.sDiaDiem
                        </span>
                        @if (job.fMucLuong > 0)
                        {
                            <span class="job-tag salary">
                                <i class="fas fa-dollar-sign"></i>@job.fMucLuong.ToString("N0") đ
                            </span>
                        }
                        else
                        {
                            <span class="job-tag">
                                <i class="fas fa-dollar-sign"></i>Thỏa thuận
                            </span>
                        }
                        <span class="job-tag @(job.dHanNop < DateTime.Now ? "deadline" : "deadline-ok")">
                            <i class="fas fa-calendar-alt"></i>Hạn: @job.dHanNop.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(job.tMoTaCV))
                    {
                        <p class="job-desc">@job.tMoTaCV</p>
                    }

                    <div class="job-card-footer">
                        <form asp-controller="Job" asp-action="Apply" method="post">
                            <input type="hidden" name="idTin" value="@job.PK_sMaTin" />
                            <button type="submit" class="btn-apply">Ứng tuyển</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" alt="empty" />
            <h5>Rất tiếc, không tìm thấy công việc phù hợp!</h5>
        </div>
    }
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
